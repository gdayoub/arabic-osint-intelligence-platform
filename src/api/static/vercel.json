{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "rewrites": [
    { "source": "/", "destination": "/dashboard.html" },
    { "source": "/index.html", "destination": "/dashboard.html" },
    { "source": "/data.json", "destination": "https://arabic-osint-dashboard.georgedayoub500.workers.dev/data.json" },
    { "source": "/countries/:path*", "destination": "https://arabic-osint-dashboard.georgedayoub500.workers.dev/countries/:path*" }
  ],
  "headers": [
    { "source": "/assets/(.*).mjs", "headers": [{ "key": "Content-Type", "value": "text/javascript; charset=utf-8" }] }
  ]
}
