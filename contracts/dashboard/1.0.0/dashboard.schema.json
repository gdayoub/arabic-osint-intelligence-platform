{
  "$defs": {
    "CountryIndexItem": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "country": {
          "minLength": 1,
          "title": "Country",
          "type": "string"
        },
        "slug": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Slug",
          "type": "string"
        }
      },
      "required": [
        "country",
        "slug",
        "count"
      ],
      "title": "CountryIndexItem",
      "type": "object"
    },
    "DailyCount": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        }
      },
      "required": [
        "date",
        "count"
      ],
      "title": "DailyCount",
      "type": "object"
    },
    "EntitySummary": {
      "additionalProperties": false,
      "properties": {
        "top": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/RankedEntity"
            },
            "type": "array"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Top",
          "type": "object"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "top"
      ],
      "title": "EntitySummary",
      "type": "object"
    },
    "EscalationDistribution": {
      "additionalProperties": false,
      "properties": {
        "escalation": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Escalation",
          "type": "object"
        }
      },
      "required": [
        "escalation"
      ],
      "title": "EscalationDistribution",
      "type": "object"
    },
    "MentionSummary": {
      "additionalProperties": false,
      "properties": {
        "top": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/RankedMention"
            },
            "type": "array"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Top",
          "type": "object"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "top"
      ],
      "title": "MentionSummary",
      "type": "object"
    },
    "RankedEntity": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "surface_forms": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Surface Forms",
          "type": "array"
        }
      },
      "required": [
        "name",
        "count",
        "surface_forms"
      ],
      "title": "RankedEntity",
      "type": "object"
    },
    "RankedMention": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "count"
      ],
      "title": "RankedMention",
      "type": "object"
    },
    "RecentArticle": {
      "additionalProperties": false,
      "properties": {
        "ai_summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ai Summary"
        },
        "country": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Country"
        },
        "escalation": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Escalation"
        },
        "processed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Processed At"
        },
        "published_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published Date"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "title_en": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title En"
        },
        "topic": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Topic"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "pattern": "^[hH][tT][tT][pP][sS]?://[^\\s\\\\\"'<>`]+$",
              "type": "string",
              "x-allowed-schemes": [
                "http",
                "https"
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "title",
        "title_en",
        "source",
        "url",
        "topic",
        "escalation",
        "country",
        "ai_summary",
        "processed_at",
        "published_date"
      ],
      "title": "RecentArticle",
      "type": "object"
    },
    "ReviewEvidence": {
      "additionalProperties": false,
      "properties": {
        "mention_id": {
          "exclusiveMinimum": 0,
          "title": "Mention Id",
          "type": "integer"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "pattern": "^[hH][tT][tT][pP][sS]?://[^\\s\\\\\"'<>`]+$",
              "type": "string",
              "x-allowed-schemes": [
                "http",
                "https"
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "mention_id",
        "text",
        "source",
        "url",
        "title"
      ],
      "title": "ReviewEvidence",
      "type": "object"
    },
    "ReviewItem": {
      "additionalProperties": false,
      "properties": {
        "distance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Distance",
          "type": "number"
        },
        "features": {
          "additionalProperties": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "title": "Features",
          "type": "object"
        },
        "id": {
          "exclusiveMinimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "left": {
          "$ref": "#/$defs/ReviewEvidence"
        },
        "object_type": {
          "minLength": 1,
          "title": "Object Type",
          "type": "string"
        },
        "right": {
          "$ref": "#/$defs/ReviewEvidence"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "threshold": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "id",
        "object_type",
        "score",
        "threshold",
        "distance",
        "features",
        "left",
        "right"
      ],
      "title": "ReviewItem",
      "type": "object"
    },
    "ReviewQueue": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ReviewItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "ReviewQueue",
      "type": "object"
    },
    "SnapshotStats": {
      "additionalProperties": false,
      "properties": {
        "sources": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Sources",
          "type": "object"
        },
        "total_processed": {
          "minimum": 0,
          "title": "Total Processed",
          "type": "integer"
        },
        "total_raw": {
          "minimum": 0,
          "title": "Total Raw",
          "type": "integer"
        }
      },
      "required": [
        "total_raw",
        "total_processed",
        "sources"
      ],
      "title": "SnapshotStats",
      "type": "object"
    },
    "TopicCount": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "count"
      ],
      "title": "TopicCount",
      "type": "object"
    },
    "TopicDistribution": {
      "additionalProperties": false,
      "properties": {
        "topics": {
          "items": {
            "$ref": "#/$defs/TopicCount"
          },
          "title": "Topics",
          "type": "array"
        }
      },
      "required": [
        "topics"
      ],
      "title": "TopicDistribution",
      "type": "object"
    }
  },
  "$id": "urn:george-dayoub:arabic-osint:dashboard:1.0.0:dashboard",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "countries": {
      "items": {
        "$ref": "#/$defs/CountryIndexItem"
      },
      "title": "Countries",
      "type": "array"
    },
    "daily": {
      "items": {
        "$ref": "#/$defs/DailyCount"
      },
      "title": "Daily",
      "type": "array"
    },
    "entities": {
      "$ref": "#/$defs/EntitySummary"
    },
    "escalation": {
      "$ref": "#/$defs/EscalationDistribution"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "mentions": {
      "$ref": "#/$defs/MentionSummary"
    },
    "recent": {
      "items": {
        "$ref": "#/$defs/RecentArticle"
      },
      "title": "Recent",
      "type": "array"
    },
    "review_queue": {
      "$ref": "#/$defs/ReviewQueue"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stats": {
      "$ref": "#/$defs/SnapshotStats"
    },
    "topics": {
      "$ref": "#/$defs/TopicDistribution"
    }
  },
  "required": [
    "generated_at",
    "schema_version",
    "stats",
    "topics",
    "escalation",
    "recent",
    "daily",
    "mentions",
    "entities",
    "review_queue",
    "countries"
  ],
  "title": "DashboardSnapshot",
  "type": "object"
}
