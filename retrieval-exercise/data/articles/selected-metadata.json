{
  "status": "selected_not_downloaded",
  "selection_sql": "WITH eligible AS (\nSELECT d.*, i.document_uid, i.identity_version,\nntile(3) OVER (PARTITION BY source ORDER BY text_length,d.id) AS length_band,\nntile(3) OVER (PARTITION BY source ORDER BY coalesce(published_at,collected_at),d.id) AS date_band\nFROM documents d LEFT JOIN document_identities i ON i.document_id=d.id\nWHERE NOT retracted AND text_blob_key IS NOT NULL AND text_sha256 IS NOT NULL\nAND d.id NOT IN (15100,15072,15053,14977,15008)\n), ranked AS (\nSELECT *, row_number() OVER (PARTITION BY source ORDER BY\nCASE WHEN length_band=date_band THEN 0 ELSE 1 END,\nmd5(id::text || 'retrieval-50-v1')) AS source_rank FROM eligible\n)\nSELECT id,document_uid,identity_version,source,url,published_at,collected_at,text_blob_key,text_sha256,text_length,length_band,date_band\nFROM ranked ORDER BY source_rank, md5(source || 'retrieval-50-v1') LIMIT 45",
